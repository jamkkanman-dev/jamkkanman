<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 멈춘 자리의 위치 (내비 위치가 없을 때 보조) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 기어 레버 위치 (Android Automotive 표준 속성 GEAR_SELECTION) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 비상등 상태 (Android Automotive 표준 속성 HAZARD_LIGHTS_STATE) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />

    <!-- Pleos Vehicle SDK: 기어(대체용), 방향지시등, 문 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- 계기판 경고등(Telltales): 좌우 방향지시등 표시가 동시에 켜지면 비상등으로 판단 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />

    <!-- Pleos NaviHelper SDK: 현재 위치·목적지 조회, 경유지 추가 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- Pleos TextToSpeech SDK: 한국어 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Pleos 음성 서비스 앱 설치 여부 확인 -->
    <queries>
        <package android:name="ai.pleos.playground.caas" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="잠깐만"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo AI 음성 요청 (assets/schema.json의 component="activity" 기능) -->
            <intent-filter>
                <action android:name="CHECK_PARKING_HERE" />
                <action android:name="FIND_LEGAL_PARKING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- Gleo AI 음성 요청 (assets/schema.json의 component="service" 기능: 화면 없이 답만) -->
        <receiver
            android:name=".car.GleoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="GET_SAVED_FINES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
